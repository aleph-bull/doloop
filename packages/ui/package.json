{
  "name": "@doloop/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design tokens and React components for the Doloop portal and extension.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./tokens.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
