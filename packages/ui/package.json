    "prepare:thumbs": "tsx scripts/prepare-thumbs.ts",
    "prepare:icons": "tsx scripts/prepare-icons.ts"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "*",
    "react-dom": "*"
  },
  "dependencies": {
    "@doloop/core": "workspace:*",
    "lucide-react": "^1.47.0"
