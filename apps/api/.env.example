# Copy to .env (never commit .env)
PORT=8787
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173

# Supabase (Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Direct Postgres connection string from Supabase > Project settings > Database (use the pooler URI)
DATABASE_URL=

# Google Calendar (Phase 6) - OAuth client from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/calendar/google/callback
# 32-byte hex key for encrypting refresh tokens at rest
TOKEN_ENCRYPTION_KEY=
DEV_AUTH_SECRET=
