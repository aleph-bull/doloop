# Copy to .env (never commit .env)
PORT=8787
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173
# Closed test: only these can use the API (addresses or @domain, comma separated). Empty is open.
ALLOWED_EMAILS=
# Admins: see every account and its data on /admin (comma separated).
ADMIN_EMAILS=
# Leave disabled outside an isolated localhost sandbox (pnpm sandbox:test:api).
LOCAL_TEST_ACCOUNTS=false

# Email-and-password accounts kept by the API itself (no Supabase sign-in needed).
# Any long random string; changing it signs everyone out.
AUTH_SECRET=
# Proxies in front of the API to trust for the caller's address (1 on Render, 0 locally).
TRUST_PROXY_HOPS=0
# Optional "Continue with Google" for those accounts: a Web OAuth client id from Google Cloud
# Console, with the portal's address as an authorised JavaScript origin. No secret needed.
GOOGLE_SIGNIN_CLIENT_ID=

# Resend: verify komogon.app, then configure these on the API server only.
# Local test accounts use an in-memory inbox instead of sending real emails.
RESEND_API_KEY=
MAIL_FROM=Komodon <noreply@komogon.app>

# Supabase (Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Direct Postgres connection string from Supabase > Project settings > Database (use the pooler URI)
DATABASE_URL=

# Google Calendar (Phase 6) - OAuth client from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/calendar/google/callback
# Outlook / Microsoft Graph: Web app registration in Microsoft Entra
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT=common
OUTLOOK_REDIRECT_URI=http://localhost:8787/api/calendar/outlook/callback
# 32-byte hex key for encrypting refresh tokens at rest (Google and Outlook)
TOKEN_ENCRYPTION_KEY=
DEV_AUTH_SECRET=

# TMDB (optional) - posters and runtimes for the Analytics "enough time to watch" cards.
# Either a v4 read access token or a v3 API key from themoviedb.org > Settings > API.
TMDB_READ_TOKEN=
TMDB_API_KEY=
