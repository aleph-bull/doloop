{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@komogon/api",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "portal",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@komogon/portal",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "sandbox-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/local/sandbox-api.mjs"
      ],
      "port": 8797
    },
    {
      "name": "sandbox",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@komogon/portal",
        "exec",
        "vite",
        "--config",
        "vite.sandbox.config.ts"
      ],
      "port": 5183
    },
    {
      "name": "sandbox-2-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/local/sandbox-api.mjs"
      ],
      "env": {
        "SANDBOX_API_PORT": "8798",
        "SANDBOX_PORTAL_PORT": "5184",
        "SANDBOX_DATA": ".pglite-sandbox-2"
      },
      "port": 8798
    },
    {
      "name": "sandbox-2",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@komogon/portal",
        "exec",
        "vite",
        "--config",
        "vite.sandbox.config.ts"
      ],
      "env": {
        "SANDBOX_API_PORT": "8798",
        "SANDBOX_PORTAL_PORT": "5184",
        "SANDBOX_DATA": ".pglite-sandbox-2"
      },
      "port": 5184
    },
    {
      "name": "sandbox-password-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/local/sandbox-api.mjs"
      ],
      "port": 8799,
      "env": {
        "SANDBOX_API_PORT": "8799",
        "SANDBOX_PORTAL_PORT": "5185",
        "SANDBOX_DATA": ".pglite-sandbox-password",
        "AUTH_SECRET": "sandbox-password-secret",
        "VITE_DEV_AUTH_SECRET": "",
        "ADMIN_EMAILS": "admin@komogon.test"
      }
    },
    {
      "name": "sandbox-password",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@komogon/portal",
        "exec",
        "vite",
        "--config",
        "vite.sandbox.config.ts"
      ],
      "port": 5185,
      "env": {
        "SANDBOX_API_PORT": "8799",
        "SANDBOX_PORTAL_PORT": "5185",
        "SANDBOX_DATA": ".pglite-sandbox-password",
        "AUTH_SECRET": "sandbox-password-secret",
        "VITE_DEV_AUTH_SECRET": "",
        "ADMIN_EMAILS": "admin@komogon.test"
      }
    }
  ]
}
